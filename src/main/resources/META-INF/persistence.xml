<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="globalTradePU" transaction-type="JTA">

        <provider>
            org.eclipse.persistence.jpa.PersistenceProvider
        </provider>

        <jta-data-source>jdbc/GlobalTradeDB</jta-data-source>

        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>


            <property name="jakarta.persistence.schema-generation.database.action"
                      value="none"/>


            <property name="eclipselink.jdbc.connection-pool.default"
                      value="external"/>


            <property name="eclipselink.cache.shared.default"
                      value="true"/>

            <property name="eclipselink.query-results-cache"
                      value="true"/>


            <property name="eclipselink.jdbc.batch-writing"
                      value="JDBC"/>

            <property name="eclipselink.jdbc.batch-writing.size"
                      value="50"/>


            <property name="eclipselink.logging.level"
                      value="INFO"/>

            <property name="eclipselink.logging.level.sql"
                      value="INFO"/>

            <property name="eclipselink.logging.timestamp"
                      value="true"/>

        </properties>

    </persistence-unit>

</persistence>